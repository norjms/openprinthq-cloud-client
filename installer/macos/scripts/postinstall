#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# OpenPrintHQ Cloud Client — .pkg postinstall (runs as root).
# Sets up the shared config dir + logs, installs/loads the LaunchDaemon
# (boot-without-login), and runs a non-fatal connectivity self-test.
set -u

APP="/Applications/OpenPrintHQ Cloud Client.app"
SUPPORT="/Library/Application Support/OpenPrintHQ"
LOGDIR="/Library/Logs/OpenPrintHQ"
PLIST="/Library/LaunchDaemons/com.openprinthq.connector.plist"

mkdir -p "$SUPPORT" "$LOGDIR"
chmod 755 "$SUPPORT" "$LOGDIR"

# (Re)load the LaunchDaemon. run-connector.mjs waits for a config, so it is safe
# to load before the user has configured anything.
if [ -f "$PLIST" ]; then
  launchctl bootout system "$PLIST" 2>/dev/null || true
  launchctl bootstrap system "$PLIST" 2>/dev/null || \
    launchctl load -w "$PLIST" 2>/dev/null || true
fi

# Non-fatal connectivity self-test.
NODE="$APP/Contents/MacOS/ophq-node"
SELFTEST="$APP/Contents/Resources/scripts/self-test.mjs"
if [ -x "$NODE" ] && [ -f "$SELFTEST" ]; then
  "$NODE" "$SELFTEST" || true
fi

# Launch the app in the installing user's GUI session so it opens to the front
# for first-run configuration (postinstall runs as root; asuser targets the
# logged-in console user). Best-effort — never fail the install over this.
CONSOLE_UID="$(stat -f %u /dev/console 2>/dev/null || echo 0)"
if [ -d "$APP" ] && [ "$CONSOLE_UID" != "0" ]; then
  launchctl asuser "$CONSOLE_UID" open -a "$APP" 2>/dev/null || true
fi

exit 0
